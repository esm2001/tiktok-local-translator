# Backend reaches Ollama on Windows; launcher checks localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_HOST_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Final text-only translation fallback after the dedicated local EN/ES model.
OLLAMA_TRANSLATION_MODEL=gemma3:4b
OLLAMA_KEEP_ALIVE=30m
TRANSLATOR_PORT=8000
OUTPUT_HOST_DIR=../TikTokTraducidos
OCR_CPU_THREADS=8
# One full pass, bounded native crops; grayscale only on suspicious coverage/confidence.
OCR_ADAPTIVE_FALLBACK=true
OCR_MAX_CROP_RETRIES=6
REVERSE_SEARCH_WAIT_SECONDS=1800
REVERSE_SEARCH_PROVIDER=google_lens
# CLEAN, ORIGINAL, two unmasked crops, Google Images, then OCR text search.
REVERSE_MAX_QUERIES=6
# Per-slide search/validation budget; every fallback round receives a fresh budget.
REVERSE_TOTAL_BUDGET_SECONDS=300
REVERSE_NEGATIVE_TTL_SECONDS=3600
LENS_HEADLESS=false
LENS_TIMEOUT_SECONDS=45
LENS_INTERACTIVE_TIMEOUT=120
LENS_MAX_CANDIDATES=12
VISUAL_MATCH_THRESHOLD=0.84
CANDIDATE_MIN_DIMENSION=400
# Local Marian is primary; Google web is best effort and Ollama is final fallback.
GOOGLE_TRANSLATE_FALLBACK=true
TRANSLATION_MODEL_DIR=/app/models/opus-mt-en-es-ct2
TRANSLATION_TIMEOUT_SECONDS=180
TRANSLATION_BUDGET_SECONDS=360
# Retry a cached service/timeout failure after this interval; ambiguous OCR stays English.
TRANSLATION_RETRY_TTL_SECONDS=60
